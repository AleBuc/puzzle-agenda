<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>alebuc.puzzleagenda</groupId>
    <artifactId>puzzle-agenda-backend</artifactId>
    <version>0.2.0-rc.2</version>
  </parent>

  <artifactId>domain</artifactId>
  <packaging>jar</packaging>

  <name>Puzzle Agenda :: Domain</name>
  <description>
    Entities, value objects, domain services, and repository ports. Zero
    framework dependencies (no Spring, no JPA, no Jackson) per Constitution
    Principle I (NON-NEGOTIABLE) — main scope is intentionally empty of
    third-party dependencies.
  </description>

  <!--
    No main-scope dependencies: this module must remain framework-free.
    Test-scope only, per Constitution Principle III: plain JUnit 5 +
    AssertJ + Mockito, no Spring context.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
